{
  "name": "test-pw",
  "version": "1.0.0",
  "description": "",
  
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox",
    "test:api": "playwright test --project=api",
    "test:highest": "playwright test --grep @highest",
    "test:high": "playwright test --grep \"@high\\\\b\"",
    "test:medium": "playwright test --grep @medium",
    "test:low": "playwright test --grep @low",
    "seed:users": "bash scripts/seed-test-users.sh",
    "cleanup:users": "bash scripts/cleanup-test-users.sh",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "codegen": "playwright codegen http://localhost"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
